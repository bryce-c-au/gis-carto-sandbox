---
import GoatCounter from '../../components/GoatCounter.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Explore the terrain around Cradle Mountain and Dove Lake in an interactive shaded relief."/><title>Cradle Mountain | Geospatial sandbox</title><link rel="icon" href={base + '/favicon.svg'}/><GoatCounter/></head><body>
<header><a href={base + '/'}>← Portfolio</a><span>GEOSPATIAL SANDBOX · TASMANIA</span></header>
<main><section class="intro"><div><p class="eyebrow">TASMANIAN WILDERNESS · TERRAIN STUDY</p><h1>Cradle Mountain</h1></div><p class="lead">An interactive study of the ridges and glacial valleys around Dove Lake. Change the light and relief to see the landscape in a different way.</p></section>
<section class="map" aria-label="Interactive shaded terrain"><div id="viewer" tabindex="0" aria-label="Cradle Mountain terrain. Drag to pan and scroll to zoom."><div class="map-label">CRADLE MOUNTAIN <span> / </span> TASMANIA</div><div class="north">N <span>↑</span></div><div id="status" role="status">Loading elevation…</div></div><div class="controls"><div class="control"><label for="light">Light direction <output id="light-value">315°</output></label><input id="light" type="range" min="0" max="359" value="315"/></div><div class="control"><label for="exaggeration">Vertical exaggeration <output id="exaggeration-value">2.0×</output></label><input id="exaggeration" type="range" min="1" max="4" step="0.1" value="2"/></div><button id="reset" type="button">Reset view</button></div><p class="hint">Drag to pan · Scroll to zoom · North is up</p></section>
<section class="story"><div><p class="eyebrow">READING THE LANDSCAPE</p><h2>Relief in a new light.</h2></div><div><p>Light skims the landscape to bring ridges, cirques and valleys into focus. Adjust the direction of the light and the height of the terrain to explore its shape.</p><p>The surface covers 6 × 7 km around Cradle Mountain and Dove Lake. The display combines detailed LiDAR-derived terrain where available with coarser elevation data in the gaps. Changes in texture can reflect differences in the sources.</p><div class="facts"><div><strong>6 × 7 km</strong><span>Map extent</span></div><div><strong>8 m</strong><span>Display grid</span></div><div><strong>1–4×</strong><span>Vertical exaggeration</span></div></div></div></section>
<section class="sources"><h2>Sources &amp; credits</h2><p>Elevation: Tasmanian Government LiDAR-derived 1 m DEM tiles, accessed via ELVIS; © State of Tasmania (the LIST), CC BY 3.0 AU. Coverage gaps use Copernicus DEM GLO-30, adapted from Copernicus WorldDEM-30 © DLR e.V. and © Airbus Defence and Space GmbH, provided under COPERNICUS by the European Union and ESA. Both sources have been resampled to an 8 m display grid. The Copernicus source represents a surface model and may include vegetation or structures.</p><p>Shading and vertical exaggeration are visual aids. This map is not intended for navigation.</p></section></main>
<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
const viewer=document.querySelector<HTMLDivElement>('#viewer')!, status=document.querySelector<HTMLDivElement>('#status')!;
const lightInput=document.querySelector<HTMLInputElement>('#light')!, exInput=document.querySelector<HTMLInputElement>('#exaggeration')!;
try {
 const scene=new THREE.Scene(); scene.background=new THREE.Color('#151c1d');
 const camera=new THREE.OrthographicCamera(-4,4,4,-4,.01,100); camera.position.set(0,20,0); camera.up.set(0,0,-1); camera.lookAt(0,0,0);
 const renderer=new THREE.WebGLRenderer({antialias:true}); renderer.setPixelRatio(Math.min(devicePixelRatio,1.5)); renderer.outputColorSpace=THREE.SRGBColorSpace; viewer.appendChild(renderer.domElement);
 const controls=new OrbitControls(camera,renderer.domElement); controls.enableRotate=false; controls.screenSpacePanning=true; controls.enableDamping=true; controls.minZoom=.65; controls.maxZoom=6; controls.target.set(0,1,0); camera.position.set(0,21,0); controls.update();
 scene.add(new THREE.AmbientLight(0xc5d0c4,1.25)); const sun=new THREE.DirectionalLight(0xffeed5,2.8); scene.add(sun);
 function lighting(){const a=Number(lightInput.value)*Math.PI/180;sun.position.set(Math.sin(a)*10,8,-Math.cos(a)*10);document.querySelector('#light-value')!.textContent=`${lightInput.value}°`;}
 lighting();lightInput.addEventListener('input',lighting);
 function resize(){const w=viewer.clientWidth,h=viewer.clientHeight;renderer.setSize(w,h);const aspect=w/h;camera.left=-4.2*aspect;camera.right=4.2*aspect;camera.top=4.2;camera.bottom=-4.2;camera.updateProjectionMatrix();} new ResizeObserver(resize).observe(viewer);resize();
 fetch(import.meta.env.BASE_URL.replace(/\/$/,'')+'/data/cradle-height.f32').then(r=>{if(!r.ok)throw Error('Elevation unavailable');return r.arrayBuffer();}).then(data=>{
  const heights=new Float32Array(data),cols=750,rows=875;if(heights.length!==cols*rows)throw Error('Invalid elevation data');
  const geometry=new THREE.PlaneGeometry(6,7,cols-1,rows-1); geometry.rotateX(-Math.PI/2);const p=geometry.attributes.position as THREE.BufferAttribute;
  for(let i=0;i<heights.length;i++)p.setY(i,heights[i]/1000); geometry.computeVertexNormals();
  const mesh=new THREE.Mesh(geometry,new THREE.MeshStandardMaterial({color:0x98a69c,roughness:1}));mesh.scale.y=Number(exInput.value); scene.add(mesh);
  function exaggerate(){mesh.scale.y=Number(exInput.value);document.querySelector('#exaggeration-value')!.textContent=`${Number(exInput.value).toFixed(1)}×`;}
  exInput.addEventListener('input',exaggerate);status.textContent='';status.hidden=true;
 }).catch(()=>{status.textContent='The elevation data could not be loaded. Please refresh and try again.'});
 document.querySelector('#reset')!.addEventListener('click',()=>{camera.position.set(0,21,0);camera.zoom=1;camera.updateProjectionMatrix();controls.target.set(0,1,0);controls.update();lightInput.value='315';exInput.value='2';lighting();exInput.dispatchEvent(new Event('input'));});
 renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera)});
} catch {status.textContent='The 3D viewer could not start. Please try a browser with WebGL enabled.';}
</script>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#11191b;color:#f0eadd;font-family:Inter,Arial,sans-serif}:global(a){color:inherit}header{height:74px;padding:0 5vw;border-bottom:1px solid #3a4846;display:flex;align-items:center;justify-content:space-between;color:#aab5ae;font-size:.82rem;letter-spacing:.14em}header a{color:#e5bb89;text-decoration:none;font-size:1rem;letter-spacing:0}main{max-width:1600px;margin:auto;padding:0 5vw 80px}.intro{display:flex;align-items:end;justify-content:space-between;gap:40px;padding:54px 0 34px}.eyebrow{font-size:.82rem;letter-spacing:.17em;color:#d5a873;font-weight:700}h1{font:400 clamp(3.4rem,8vw,7.5rem)/.95 Georgia,serif;letter-spacing:-.05em;margin:18px 0 0}.lead{max-width:420px;line-height:1.6;color:#bdc8c0;font-size:1.1rem}.map{border:1px solid #45514c;background:#10191a}#viewer{height:min(68vw,740px);min-height:430px;position:relative;overflow:hidden;background:#151c1d}#viewer canvas{display:block;width:100%;height:100%}.map-label,.north{position:absolute;z-index:1;top:22px;color:#ecede0;font-size:.72rem;letter-spacing:.16em;font-weight:700;pointer-events:none;text-shadow:0 1px 8px #000}.map-label{left:22px}.map-label span{color:#cfac7c}.north{right:24px;display:grid;gap:5px;text-align:center}.north span{font-size:1.4rem}#status{position:absolute;left:22px;bottom:20px;background:#101819dd;padding:10px 15px}.controls{display:flex;gap:35px;align-items:end;padding:22px;border-top:1px solid #45514c}.control{flex:1;max-width:290px}.control label{display:flex;justify-content:space-between;color:#dbe2db;font-size:.9rem;margin-bottom:12px}.control output{color:#e5bb89}input[type=range]{width:100%;accent-color:#d5a873}button{border:1px solid #62736a;color:#efdfca;background:#263432;padding:11px 17px;font:inherit;cursor:pointer}button:hover{background:#3a4c45}.hint{margin:0;padding:0 22px 20px;color:#aab5ae;font-size:.85rem}.story{display:grid;grid-template-columns:1fr 1.25fr;gap:8vw;padding:85px 0;border-bottom:1px solid #3a4846}h2{font:400 clamp(2.5rem,5vw,4.5rem)/1.05 Georgia,serif;margin:12px 0}.story p,.sources p{color:#bdc8c0;line-height:1.7;font-size:1.05rem}.facts{display:flex;gap:35px;margin-top:40px}.facts div{display:flex;flex-direction:column;gap:8px}.facts strong{font:400 1.7rem Georgia,serif;color:#f0d0a8}.facts span{color:#aab5ae;font-size:.85rem}.sources{max-width:950px;padding-top:60px}.sources h2{font-size:2.5rem}.sources p{font-size:.9rem}@media(max-width:800px){header{padding:0 20px}header span{display:none}main{padding:0 20px 60px}.intro{display:block;padding:40px 0 28px}.lead{margin-top:25px}#viewer{height:60vh;min-height:360px}.controls{flex-wrap:wrap;gap:20px}.control{min-width:200px;max-width:none}.story{grid-template-columns:1fr;gap:10px;padding:55px 0}.facts{flex-wrap:wrap;gap:25px}}
</style></body></html>
