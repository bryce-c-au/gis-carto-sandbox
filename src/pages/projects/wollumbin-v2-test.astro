const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Wollumbin | Terrain comparison</title></head><body><main><header><p class="eyebrow">LIDAR TERRAIN COMPARISON</p><h1>Wollumbin <em>in detail</em></h1><p>Explore a closer 6 × 6 km view of Wollumbin. Compare a LiDAR-derived terrain model with the existing elevation surface, and switch between satellite and aerial imagery.</p></header><section class="panel"><div class="toolbar"><div class="group"><span>Terrain</span><button type="button" id="terrain-v1" aria-pressed="false">V1 terrain</button><button type="button" id="terrain-lidar" aria-pressed="true">LiDAR terrain</button></div><div class="group"><span>Surface</span><button type="button" id="surface-satellite" aria-pressed="true">V1 satellite</button><button type="button" id="surface-aerial" aria-pressed="false" disabled>Loading aerial…</button><button type="button" id="surface-relief" aria-pressed="false">Relief</button></div></div><div id="viewer" tabindex="0" aria-label="Interactive terrain comparison of Wollumbin. Drag to rotate and scroll to zoom."><div id="status" role="status">Loading the comparison…</div><div class="viewer-label">WOLLUMBIN <span>/</span> 6 × 6 KM TEST</div></div><div class="footer"><span>Drag to orbit · Scroll to zoom · Right-drag to pan</span><button type="button" id="reset">Reset view</button></div></section><section class="notes"><div><p class="eyebrow">WHAT CHANGED</p><h2>Compare the details.</h2></div><div><p>The LiDAR surface is built from the supplied NSW 2 m Murwillumbah DEM tiles, resampled to a 6 m mesh for this test. The V1 comparison uses the existing stereo-derived surface, approximately 20–22 m before resampling to the same mesh.</p><p>Aerial imagery is loaded directly from the NSW Imagery web service at approximately 3 m per image pixel. The service includes third-party imagery (including © AAM); image dates and sources vary. The V1 satellite layer uses Copernicus Sentinel-2, approximately 10 m.</p><p>The model uses 1.5× vertical exaggeration. Both surfaces cover the same area and can be inspected from the same camera position. The scene is not a navigation or access map. Wollumbin is a place of deep cultural significance to Aboriginal people, particularly the Bundjalung nation. The upper reaches, including the summit, are a declared Aboriginal Place. For current access information, see <a href="https://www.nationalparks.nsw.gov.au/visit-a-park/parks/wollumbin-national-park">NSW National Parks</a>.</p><p>Terrain: Murwillumbah 2017 LiDAR DEM, © NSW Spatial Services, Department of Customer Service, CC BY 3.0 Australia. Elevation tiles extracted from ELVIS on 25 November 2026 and resampled. Aerial: NSW Imagery web service, © State of NSW (Spatial Services), with third-party imagery including © AAM. Satellite: modified Copernicus Sentinel-2 data, 3 September 2026, processed by Earth Search / AWS. The two terrain surfaces and image sources have different capture dates.</p></div></section></main>
<script>
import * as THREE from 'three';import{OrbitControls}from'three/addons/controls/OrbitControls.js';
const viewer=document.querySelector<HTMLDivElement>('#viewer')!,status=document.querySelector<HTMLDivElement>('#status')!,base=import.meta.env.BASE_URL.replace(/\/$/,'');
try{
 const scene=new THREE.Scene();scene.background=new THREE.Color('#0d1414');const camera=new THREE.PerspectiveCamera(38,1,.05,80);const renderer=new THREE.WebGLRenderer({antialias:true});renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;viewer.appendChild(renderer.domElement);
 const controls=new OrbitControls(camera,renderer.domElement);controls.enableDamping=true;controls.maxPolarAngle=Math.PI*.49;controls.minDistance=2.5;controls.maxDistance=24;controls.screenSpacePanning=true;function home(){camera.position.set(-7,6,8);controls.target.set(0,.55,0);controls.update()}home();document.querySelector('#reset')!.addEventListener('click',home);
 scene.add(new THREE.HemisphereLight(0xe9f4e5,0x7a6652,2.5));const sun=new THREE.DirectionalLight(0xffe8cc,2.6);sun.position.set(-8,10,-7);scene.add(sun);
 function resize(){const w=viewer.clientWidth,h=viewer.clientHeight;if(!w||!h)return;camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h)}new ResizeObserver(resize).observe(viewer);resize();
 const loadImage=(path:string)=>new Promise<THREE.Texture>((resolve,reject)=>new THREE.TextureLoader().load(path.startsWith('https://')?path:base+path,resolve,undefined,reject));const loadData=(path:string)=>fetch(base+path).then(r=>{if(!r.ok)throw Error('Terrain unavailable');return r.arrayBuffer()});
 const aerialPromise=Promise.race([loadImage('https://maps.six.nsw.gov.au/arcgis/rest/services/public/NSW_Imagery/MapServer/export?bbox=524000%2C6856000%2C530000%2C6862000&bboxSR=28356&imageSR=28356&size=2000%2C2000&format=jpg&f=image&dpi=96').catch(()=>null),new Promise<null>(resolve=>window.setTimeout(()=>resolve(null),45000))]);
 Promise.all([loadData('/data/wollumbin-v1-test.f32'),loadData('/data/wollumbin-lidar-test.f32'),loadImage('/images/wollumbin-sentinel-test.webp')]).then(([oldBuf,newBuf,oldTex])=>{
 let newTex:THREE.Texture|null=null;
 const oldH=new Float32Array(oldBuf),newH=new Float32Array(newBuf),cols=1000,rows=1000;if(oldH.length!==cols*rows||newH.length!==cols*rows)throw Error('Invalid terrain');oldTex.colorSpace=THREE.SRGBColorSpace;oldTex.anisotropy=Math.min(renderer.capabilities.getMaxAnisotropy(),8);
 const geometry=new THREE.PlaneGeometry(6,6,cols-1,rows-1);geometry.rotateX(-Math.PI/2);const pos=geometry.attributes.position as THREE.BufferAttribute;const material=new THREE.MeshStandardMaterial({map:oldTex,roughness:1});scene.add(new THREE.Mesh(geometry,material));
 const buttons=['terrain-v1','terrain-lidar','surface-satellite','surface-aerial','surface-relief'].map(id=>document.getElementById(id) as HTMLButtonElement);
 function setTerrain(data:Float32Array,lidar:boolean){for(let i=0;i<data.length;i++)pos.setY(i,Math.max(0,data[i])/1000*1.5);pos.needsUpdate=true;geometry.computeVertexNormals();buttons[0].setAttribute('aria-pressed',String(!lidar));buttons[1].setAttribute('aria-pressed',String(lidar))}
 function setSurface(kind:number){material.map=kind===0?oldTex:kind===1?newTex:null;material.color.set(kind===2?0xb8aa8c:0xffffff);material.needsUpdate=true;buttons.slice(2).forEach((b,i)=>b.setAttribute('aria-pressed',String(i===kind)))}
 aerialPromise.then(t=>{if(!t){buttons[3].textContent='Aerial unavailable';buttons[3].title='NSW imagery is currently unavailable or timed out; try refreshing the page';return}newTex=t;t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=Math.min(renderer.capabilities.getMaxAnisotropy(),8);buttons[3].disabled=false;buttons[3].textContent='NSW aerial'});buttons[0].addEventListener('click',()=>setTerrain(oldH,false));buttons[1].addEventListener('click',()=>setTerrain(newH,true));buttons[2].addEventListener('click',()=>setSurface(0));buttons[3].addEventListener('click',()=>setSurface(1));buttons[4].addEventListener('click',()=>setSurface(2));setTerrain(newH,true);status.hidden=true;
 }).catch(()=>{status.textContent='The comparison data could not be loaded. Please refresh and try again.'});renderer.setAnimationLoop(()=>{controls.update();renderer.render(scene,camera)});
}catch{status.textContent='The comparison needs a browser with WebGL enabled.'}
</script>
<style>:global(*){box-sizing:border-box}:global(body){margin:0;background:#11191b;color:#f0eadd;font-family:Inter,Arial,sans-serif}main{max-width:1500px;margin:auto;padding:0 5vw 80px}header{display:grid;grid-template-columns:1fr 1fr;gap:25px;padding:55px 0 35px}header .eyebrow{grid-column:1/-1;margin:0}.eyebrow{color:#d5a873;font-size:.8rem;font-weight:700;letter-spacing:.17em}h1{font:400 clamp(3rem,7vw,6.5rem)/.95 Georgia,serif;letter-spacing:-.04em;margin:0}h1 em{color:#dfb17a;font-weight:400}header>p:last-child{max-width:520px;color:#bdc8c0;line-height:1.6;align-self:end}.panel{border:1px solid #45514c;background:#0b1012}.toolbar,.footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:14px 20px;flex-wrap:wrap;color:#bbc7bd}.group{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.group span{font-size:.85rem;margin-right:6px}button{color:#f0deca;background:#263432;border:1px solid #566760;padding:9px 14px;font:inherit;cursor:pointer}button:hover,button[aria-pressed=true]{background:#516557}button:disabled{opacity:.55;cursor:wait}#viewer{height:min(65vw,720px);min-height:420px;position:relative;overflow:hidden;border-top:1px solid #45514c;border-bottom:1px solid #45514c}#viewer canvas{display:block;width:100%;height:100%}#status{position:absolute;bottom:20px;left:20px;background:#101819dd;padding:10px 14px}.viewer-label{position:absolute;top:20px;left:20px;font-size:.75rem;letter-spacing:.15em;font-weight:700;pointer-events:none}.viewer-label span{color:#d5a873}.footer{font-size:.9rem}.notes{display:grid;grid-template-columns:1fr 1.25fr;gap:8vw;padding:75px 0}.notes h2{font:400 clamp(2.4rem,4vw,4rem)/1.05 Georgia,serif;margin:12px 0}.notes p:not(.eyebrow){color:#bdc8c0;line-height:1.7}@media(max-width:800px){main{padding:0 20px 60px}header,.notes{grid-template-columns:1fr}.toolbar{align-items:start}#viewer{height:60vh;min-height:350px}.notes{padding:50px 0;gap:10px}}</style></body></html>
